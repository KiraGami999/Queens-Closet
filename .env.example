# Neon Postgres — pooled connection (used by Prisma Client via @prisma/adapter-neon)
DATABASE_URL=
# Neon Postgres — direct/unpooled connection (used by the Prisma CLI for migrations)
DIRECT_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public app URL (used for absolute links, e.g. in emails or callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Virtual try-on AI provider: mock | fashn | fal
# - mock  → free stand-in (no AI_API_KEY required)
# - fashn → set AI_API_KEY to your FASHN key
# - fal   → set AI_API_KEY to your fal.ai key
AI_PROVIDER=mock
AI_API_KEY=

# Image storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
